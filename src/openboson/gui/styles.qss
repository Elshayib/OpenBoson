/* OpenBoson dark theme — deep navy + cyan accent.
   Type scale · 12px cards · hairline pills · solid primary · muted chrome. */

* {
    font-family: "Inter", "Segoe UI", "Cantarell", sans-serif;
}

QMainWindow, #Content, QStackedWidget, #ScrollContent, #CardHolder {
    background-color: #0f1420;
    color: #e6edf3;
}

QStackedWidget > QWidget {
    background-color: #0f1420;
}

QWidget {
    color: #e6edf3;
}

QLabel {
    color: #e6edf3;
    background-color: transparent;
}

QLabel[role="h1"] {
    font-size: 22px;
    font-weight: 750;
    padding: 0 0 6px 0;
    color: #f0f6fc;
    letter-spacing: -0.6px;
}

QLabel[role="h2"] {
    font-size: 11pt;
    font-weight: 650;
    color: #c9d1d9;
    letter-spacing: -0.1px;
}

QLabel[role="muted"] {
    color: #8b949e;
    font-size: 9.5pt;
}

QLabel[role="accent"] {
    font-size: 22px;
    font-weight: 700;
    color: #58a6ff;
}

/* Top command bar — grouped hairline pills, not a flat accent slab */
#TopBar {
    background-color: #0b1019;
    border-bottom: 1px solid #1f2638;
}

#TopBar QLabel#BrandIcon {
    background-color: transparent;
}

#NavPills {
    background-color: #121826;
    border: 1px solid #2a3348;
    border-radius: 999px;
    padding: 2px 3px;
}

#TopBar QPushButton {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 5px 14px;
    text-align: center;
    font-size: 10pt;
    font-weight: 600;
    margin: 0 1px;
}

#TopBar QPushButton:hover {
    background-color: #1a2336;
    color: #e6edf3;
}

#TopBar QPushButton:checked {
    background-color: #1a2740;
    color: #f0f6fc;
    border: 1px solid #3d6db5;
    font-weight: 700;
}

#TopBar QPushButton#Brand,
#TopBar QPushButton#Brand:disabled {
    font-size: 13pt;
    font-weight: 800;
    color: #f0f6fc;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 10px 4px 4px;
    margin-right: 10px;
    letter-spacing: -0.4px;
}

#ExamChrome {
    background-color: #0b1019;
    border-bottom: 1px solid #1f2638;
}

#QuestionGrid {
    background-color: #0b1019;
    border-top: 1px solid #1f2638;
    border-right: none;
}

#ExamActions {
    background-color: #0b1019;
    border-top: 1px solid #1f2638;
}

/* Cards — 12px radius, clearer edge, extra QSS padding */
QFrame#Card {
    background-color: #161b27;
    border: 1px solid #2d3648;
    border-radius: 12px;
    padding: 6px 8px;
}

QFrame#KpiCard {
    background-color: #161b27;
    border: 1px solid #2d3648;
    border-radius: 12px;
    padding: 6px 8px;
}

QFrame#ActivityRow {
    background-color: #161b27;
    border: 1px solid #2d3648;
    border-radius: 10px;
}

QFrame#TableRow {
    background-color: #161b27;
    border: 1px solid #2d3648;
    border-radius: 10px;
}

QFrame#SettingsNav {
    background-color: #161b27;
    border: 1px solid #2d3648;
    border-radius: 12px;
}

QFrame#SettingsNav QPushButton {
    background-color: transparent;
    color: #8b949e;
    border: none;
    border-radius: 8px;
    padding: 8px 10px;
    text-align: left;
    font-weight: 500;
}

QFrame#SettingsNav QPushButton:checked {
    background-color: #1a2740;
    color: #f0f6fc;
    font-weight: 700;
}

QFrame#SettingsNav QPushButton:hover {
    background-color: #1a2336;
    color: #e6edf3;
}

/* Teaching copy (harmless if the widget is missing) */
#TeachingFeedback {
    background-color: #161b27;
    border: 1px solid #2d3648;
    border-radius: 12px;
    padding: 12px 14px;
}

#ExplanationBody {
    color: #c9d1d9;
    font-size: 10.5pt;
    background-color: transparent;
    padding: 2px 0;
}

/* First-run cert picker */
QDialog#FirstRunDialog {
    background-color: #0f1420;
    color: #e6edf3;
}

QPushButton#CertChoice {
    background-color: #161b27;
    color: #f0f6fc;
    border: 1px solid #2d3648;
    border-radius: 12px;
    padding: 16px 18px;
    font-size: 13pt;
    font-weight: 700;
    text-align: left;
    min-height: 52px;
}

QPushButton#CertChoice:hover {
    background-color: #1a2740;
    border-color: #58a6ff;
    color: #ffffff;
}

/* Drag-match slots */
#MatchSlot {
    border: 1px dashed #484f58;
    border-radius: 8px;
    background-color: #161b22;
}

#MatchSlot[matchState="hover"] {
    border: 2px solid #58a6ff;
    background-color: #1f2937;
}

#MatchSlot[matchState="filled"] {
    border: 1px solid #3fb950;
    background-color: #12261a;
}

/* Solid primary vs quiet secondary */
QPushButton#Primary {
    background-color: #1f6feb;
    color: #ffffff;
    border: 1px solid #1f6feb;
    padding: 7px 16px;
    border-radius: 8px;
    font-weight: 700;
}

QPushButton#Primary:hover {
    background-color: #388bfd;
    color: #ffffff;
    border-color: #388bfd;
}

QPushButton#Primary:disabled {
    background-color: #21262d;
    color: #6e7681;
    border-color: #30363d;
}

QPushButton#Secondary {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid #30363d;
    padding: 7px 16px;
    border-radius: 8px;
    font-weight: 500;
}

QPushButton#Secondary:hover {
    background-color: #161b27;
    border-color: #484f58;
    color: #e6edf3;
}

QPushButton#Secondary:checked {
    background-color: #1a2740;
    color: #f0f6fc;
    border-color: #3d6db5;
    font-weight: 700;
}

QToolButton#Secondary {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid #30363d;
    padding: 7px 16px;
    border-radius: 8px;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox {
    background-color: #0b1019;
    border: 1px solid #30363d;
    padding: 6px 10px;
    border-radius: 8px;
    color: #e6edf3;
    selection-background-color: #2f81f7;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #58a6ff;
}

QComboBox QAbstractItemView {
    background-color: #0b1019;
    color: #e6edf3;
    border: 1px solid #30363d;
    selection-background-color: #2f81f7;
    selection-color: #ffffff;
}

QTextEdit, QPlainTextEdit, QTextBrowser {
    background-color: #0b1019;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px;
    color: #e6edf3;
    selection-background-color: #2f81f7;
    selection-color: #ffffff;
}

QPlainTextEdit#CiscoTerminal {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 10.5pt;
}

QWidget#LabSidePane {
    background-color: #0b1019;
}

QPushButton#LabObjectivePending {
    text-align: left;
    color: #8b9cb3;
}
QPushButton#LabObjectivePassed {
    text-align: left;
    color: #3fb950;
}
QPushButton#LabObjectiveFailed {
    text-align: left;
    color: #f85149;
}

QLabel#LabFeedbackOk {
    color: #3fb950;
}
QLabel#LabFeedbackBad {
    color: #f85149;
}

QWidget#TopologyCanvas {
    background-color: #0a0e16;
    border-radius: 8px;
}

QTextBrowser#CardText,
QFrame#Card QTextBrowser {
    background-color: transparent;
    border: none;
    padding: 0;
    color: #e6edf3;
}

QListWidget {
    background-color: #0b1019;
    border: 1px solid #2d3648;
    border-radius: 8px;
    padding: 2px;
    color: #e6edf3;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: #e6edf3;
}

QListWidget::item:selected {
    background-color: #1f6feb;
    color: white;
}

QProgressBar {
    background-color: #0b1019;
    border: 1px solid #30363d;
    border-radius: 4px;
    text-align: center;
    color: white;
    max-height: 14px;
}

QProgressBar::chunk {
    background-color: #2f81f7;
    border-radius: 3px;
}

QFrame#TrendBar {
    background-color: #1a2740;
    border-radius: 3px;
}

QFrame#TrendBar[active="true"] {
    background-color: #2f81f7;
}

QStatusBar {
    background-color: #0b1019;
    color: #6e7681;
    border-top: 1px solid #1f2638;
    font-size: 8.5pt;
    min-height: 20px;
    padding: 0 10px;
}

QStatusBar QLabel {
    color: #6e7681;
    font-size: 8.5pt;
}

QRadioButton, QCheckBox {
    color: #e6edf3;
    background-color: transparent;
    padding: 2px 0;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #0b1019;
    border: 1px solid #30363d;
    border-radius: 3px;
}

QRadioButton::indicator { border-radius: 7px; }

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #2f81f7;
    border-color: #2f81f7;
}

QTabWidget::pane {
    background-color: #0b1019;
    border: 1px solid #2d3648;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #161b27;
    color: #8b949e;
    border: 1px solid #2d3648;
    padding: 6px 12px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #0d1117;
    color: #f0f6fc;
    border-bottom-color: #0d1117;
}

QSplitter::handle {
    background-color: #1f2638;
}

QScrollArea, QScrollArea#PageScroll {
    background-color: #0f1420;
    border: none;
}

QScrollArea#PageScroll > QWidget > QWidget,
QScrollArea > QWidget#ScrollContent {
    background-color: #0f1420;
}

QScrollBar:vertical {
    background: #0b1019;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0b1019;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #161b27;
    color: #e6edf3;
    border: 1px solid #30363d;
}

QDialog {
    background-color: #0f1420;
    color: #e6edf3;
}
