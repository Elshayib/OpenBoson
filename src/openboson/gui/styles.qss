/* OpenBoson dark theme — deep navy + cyan accent. */

* {
    font-family: "Segoe UI", "Inter", "Cantarell", sans-serif;
}

QMainWindow, #Content, QStackedWidget, #ScrollContent, #CardHolder {
    background-color: #0f1420;
    color: #e6edf3;
}

QStackedWidget > QWidget {
    background-color: #0f1420;
}

QWidget {
    color: #e6edf3;
}

QLabel {
    color: #e6edf3;
    background-color: transparent;
}

QLabel[role="h1"] {
    font-size: 22pt;
    font-weight: 600;
    padding: 8px 0;
    color: #e6edf3;
}

QLabel[role="h2"] {
    font-size: 14pt;
    font-weight: 600;
    color: #79c0ff;
}

QLabel[role="muted"] {
    color: #8b949e;
}

QLabel[role="accent"] {
    font-size: 28px;
    font-weight: 700;
    color: #58a6ff;
}

/* Sidebar */
#Sidebar {
    background-color: #0b1019;
    border-right: 1px solid #1f2638;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #c9d1d9;
    border: none;
    padding: 10px 16px;
    text-align: left;
    font-size: 11pt;
    border-left: 3px solid transparent;
    margin: 2px 0;
}

#Sidebar QPushButton:hover {
    background-color: #161b27;
    color: #ffffff;
}

#Sidebar QPushButton:checked {
    background-color: #161b27;
    color: #ffffff;
    border-left: 3px solid #2f81f7;
}

#Sidebar QPushButton#Brand,
#Sidebar QPushButton#Brand:disabled {
    font-size: 13pt;
    font-weight: 700;
    color: #79c0ff;
    background-color: transparent;
    border-left: 3px solid transparent;
    padding: 12px 16px;
}

/* Card */
QFrame#Card {
    background-color: #161b27;
    border: 1px solid #1f2638;
    border-radius: 8px;
}

/* Drag-match slots */
#MatchSlot {
    border: 1px dashed #484f58;
    border-radius: 6px;
    background-color: #161b22;
}

#MatchSlot[matchState="hover"] {
    border: 2px solid #58a6ff;
    background-color: #1f2937;
}

#MatchSlot[matchState="filled"] {
    border: 1px solid #3fb950;
    background-color: #12261a;
}

/* Primary button */
QPushButton#Primary {
    background-color: #2f81f7;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton#Primary:hover { background-color: #3b8ef0; }
QPushButton#Primary:disabled { background-color: #444c56; color: #8b949e; }

/* Secondary button */
QPushButton#Secondary {
    background-color: transparent;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 8px 16px;
    border-radius: 6px;
}

QPushButton#Secondary:hover {
    background-color: #161b27;
    border-color: #2f81f7;
    color: #ffffff;
}

QPushButton#Secondary:checked {
    background-color: #1f6feb;
    color: white;
    border-color: #1f6feb;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox {
    background-color: #0b1019;
    border: 1px solid #30363d;
    padding: 6px 10px;
    border-radius: 4px;
    color: #e6edf3;
    selection-background-color: #2f81f7;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #2f81f7;
}

QComboBox QAbstractItemView {
    background-color: #0b1019;
    color: #e6edf3;
    border: 1px solid #30363d;
    selection-background-color: #2f81f7;
    selection-color: #ffffff;
}

QTextEdit, QPlainTextEdit, QTextBrowser {
    background-color: #0b1019;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px;
    color: #e6edf3;
    selection-background-color: #2f81f7;
    selection-color: #ffffff;
}

QPlainTextEdit#CiscoTerminal {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 10px;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 11pt;
}

QPushButton#LabObjectivePending {
    text-align: left;
    color: #8b9cb3;
}
QPushButton#LabObjectivePassed {
    text-align: left;
    color: #3fb950;
}
QPushButton#LabObjectiveFailed {
    text-align: left;
    color: #f85149;
}

QLabel#LabFeedbackOk {
    color: #3fb950;
}
QLabel#LabFeedbackBad {
    color: #f85149;
}

QWidget#TopologyCanvas {
    background-color: #0a0e16;
    border-radius: 8px;
}

/* Stem / explanation browsers sit on Cards — blend with card surface */
QTextBrowser#CardText,
QFrame#Card QTextBrowser {
    background-color: transparent;
    border: none;
    padding: 0;
    color: #e6edf3;
}

/* Lists */
QListWidget {
    background-color: #0b1019;
    border: 1px solid #1f2638;
    border-radius: 6px;
    padding: 4px;
    color: #e6edf3;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #e6edf3;
}

QListWidget::item:selected {
    background-color: #1f6feb;
    color: white;
}

/* Progress bar */
QProgressBar {
    background-color: #0b1019;
    border: 1px solid #30363d;
    border-radius: 4px;
    text-align: center;
    color: white;
}

QProgressBar::chunk {
    background-color: #2f81f7;
    border-radius: 4px;
}

/* Status bar */
QStatusBar {
    background-color: #0b1019;
    color: #8b949e;
    border-top: 1px solid #1f2638;
}

/* Radio / checkbox */
QRadioButton, QCheckBox {
    color: #e6edf3;
    background-color: transparent;
    padding: 4px 0;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #0b1019;
    border: 1px solid #30363d;
    border-radius: 3px;
}

QRadioButton::indicator { border-radius: 8px; }

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #2f81f7;
    border-color: #2f81f7;
}

QTabWidget::pane {
    background-color: #0b1019;
    border: 1px solid #1f2638;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #161b27;
    color: #c9d1d9;
    border: 1px solid #1f2638;
    padding: 8px 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #0b1019;
    color: #79c0ff;
    border-bottom-color: #0b1019;
}

QSplitter::handle {
    background-color: #1f2638;
}

QScrollArea, QScrollArea#PageScroll {
    background-color: #0f1420;
    border: none;
}

QScrollArea#PageScroll > QWidget > QWidget,
QScrollArea > QWidget#ScrollContent {
    background-color: #0f1420;
}

QScrollBar:vertical {
    background: #0b1019;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0b1019;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #161b27;
    color: #e6edf3;
    border: 1px solid #30363d;
}
