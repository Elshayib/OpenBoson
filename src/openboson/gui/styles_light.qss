/* OpenBoson light theme — light gray + blue accent. */

* {
    font-family: "Segoe UI", "Inter", "Cantarell", sans-serif;
}

QMainWindow, #Content, QStackedWidget, #ScrollContent, #CardHolder {
    background-color: #f5f7fb;
    color: #1f2328;
}

QStackedWidget > QWidget {
    background-color: #f5f7fb;
}

QWidget {
    color: #1f2328;
}

QLabel {
    color: #1f2328;
    background-color: transparent;
}

QLabel[role="h1"] {
    font-size: 22pt;
    font-weight: 600;
    padding: 8px 0;
    color: #1f2328;
}

QLabel[role="h2"] {
    font-size: 14pt;
    font-weight: 600;
    color: #0969da;
}

QLabel[role="muted"] {
    color: #656d76;
}

QLabel[role="accent"] {
    font-size: 28px;
    font-weight: 700;
    color: #0969da;
}

/* Sidebar */
#Sidebar {
    background-color: #eef1f6;
    border-right: 1px solid #d0d7de;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #424a53;
    border: none;
    padding: 10px 16px;
    text-align: left;
    font-size: 11pt;
    border-left: 3px solid transparent;
    margin: 2px 0;
}

#Sidebar QPushButton:hover {
    background-color: #e6ebf2;
    color: #1f2328;
}

#Sidebar QPushButton:checked {
    background-color: #ddf4ff;
    color: #0969da;
    border-left: 3px solid #0969da;
}

#Sidebar QPushButton#Brand,
#Sidebar QPushButton#Brand:disabled {
    font-size: 13pt;
    font-weight: 700;
    color: #0969da;
    background-color: transparent;
    border-left: 3px solid transparent;
    padding: 12px 16px;
}

/* Card */
QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
}

/* Drag-match slots */
#MatchSlot {
    border: 1px dashed #afb8c1;
    border-radius: 6px;
    background-color: #f6f8fa;
}

#MatchSlot[matchState="hover"] {
    border: 2px solid #0969da;
    background-color: #ddf4ff;
}

#MatchSlot[matchState="filled"] {
    border: 1px solid #1a7f37;
    background-color: #dafbe1;
}

/* Primary button */
QPushButton#Primary {
    background-color: #0969da;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton#Primary:hover { background-color: #0860ca; }
QPushButton#Primary:disabled { background-color: #afb8c1; color: #ffffff; }

/* Secondary button */
QPushButton#Secondary {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    padding: 8px 16px;
    border-radius: 6px;
}

QPushButton#Secondary:hover {
    background-color: #f6f8fa;
    border-color: #0969da;
    color: #0969da;
}

QPushButton#Secondary:checked {
    background-color: #0969da;
    color: white;
    border-color: #0969da;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    padding: 6px 10px;
    border-radius: 4px;
    color: #1f2328;
    selection-background-color: #0969da;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #0969da;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    selection-background-color: #0969da;
    selection-color: #ffffff;
}

QTextEdit, QPlainTextEdit, QTextBrowser {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 8px;
    color: #1f2328;
    selection-background-color: #0969da;
    selection-color: #ffffff;
}

QPlainTextEdit#CiscoTerminal {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 10px;
    color: #1f2328;
    selection-background-color: #0969da;
    selection-color: #ffffff;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 11pt;
}

QPushButton#LabObjectivePending {
    text-align: left;
    color: #656d76;
}
QPushButton#LabObjectivePassed {
    text-align: left;
    color: #1a7f37;
}
QPushButton#LabObjectiveFailed {
    text-align: left;
    color: #cf222e;
}

QLabel#LabFeedbackOk {
    color: #1a7f37;
}
QLabel#LabFeedbackBad {
    color: #cf222e;
}

QWidget#TopologyCanvas {
    background-color: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 8px;
}

/* Stem / explanation browsers sit on Cards — no dark inset box */
QTextBrowser#CardText,
QFrame#Card QTextBrowser {
    background-color: transparent;
    border: none;
    padding: 0;
    color: #1f2328;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 4px;
    color: #1f2328;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #1f2328;
}

QListWidget::item:selected {
    background-color: #0969da;
    color: white;
}

QProgressBar {
    background-color: #eef1f6;
    border: 1px solid #d0d7de;
    border-radius: 4px;
    text-align: center;
    color: #1f2328;
}

QProgressBar::chunk {
    background-color: #0969da;
    border-radius: 4px;
}

QStatusBar {
    background-color: #eef1f6;
    color: #656d76;
    border-top: 1px solid #d0d7de;
}

QRadioButton, QCheckBox {
    color: #1f2328;
    background-color: transparent;
    padding: 4px 0;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 3px;
}

QRadioButton::indicator { border-radius: 8px; }

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #0969da;
    border-color: #0969da;
}

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #eef1f6;
    color: #424a53;
    border: 1px solid #d0d7de;
    padding: 8px 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0969da;
    border-bottom-color: #ffffff;
}

QSplitter::handle {
    background-color: #d0d7de;
}

QScrollArea, QScrollArea#PageScroll {
    background-color: #f5f7fb;
    border: none;
}

QScrollArea#PageScroll > QWidget > QWidget,
QScrollArea > QWidget#ScrollContent {
    background-color: #f5f7fb;
}

QScrollBar:vertical {
    background: #eef1f6;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #afb8c1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #eef1f6;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #afb8c1;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
}
